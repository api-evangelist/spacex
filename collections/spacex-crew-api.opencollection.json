                "description": "Resource UUID (MongoDB ObjectId, e.g. `5e9d0d95eda69973a809d1ec`)."
              }
            ]
          },
          "docs": "Return a single crew member record by its UUID."
        },
        {
          "info": {
            "name": "Query Crew",
            "type": "http"
