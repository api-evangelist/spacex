{
  "$schema": "https://json-structure.org/meta/core/v0/#",
  "$id": "https://raw.githubusercontent.com/api-evangelist/spacex/refs/heads/main/json-structure/spacex-company-structure.json",
  "name": "SpaceX Company",
  "description": "SpaceX company info document (single). Derived from the r-spacex/SpaceX-API mongoose model.",
  "x-schema-source": "documentation",
  "x-source-url": "https://github.com/r-spacex/SpaceX-API/tree/master/docs",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "founder": {
      "type": "string"
    },
    "founded": {
      "type": "int32"
    },
    "employees": {
      "type": "int32"
    },
    "vehicles": {
      "type": "int32"
    },
    "launch_sites": {
      "type": "int32"
    },
    "test_sites": {
      "type": "int32"
    },
    "ceo": {
      "type": "string"
    },
    "cto": {
      "type": "string"
    },
    "coo": {
      "type": "string"
    },
    "cto_propulsion": {
      "type": "string"
    },
    "valuation": {
      "type": "double"
    },
    "headquarters": {
      "type": "object",
      "properties": {
        "address": {
          "type": "string"
        },
        "city": {
          "type": "string"
        },
        "state": {
          "type": "string"
        }
      }
    },
    "links": {
      "type": "object",
      "properties": {
        "website": {
          "type": "uri"
        },
        "flickr": {
          "type": "uri"
        },
        "twitter": {
          "type": "uri"
        },
        "elon_twitter": {
          "type": "uri"
        }
      }
    },
    "summary": {
      "type": "string"
    }
  }
}